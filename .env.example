SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional — error monitoring. Create a project at https://sentry.io and paste the DSN here.
# Leave blank to disable Sentry (errors are still surfaced in the UI, just not reported remotely).
VITE_SENTRY_DSN=""

# Optional — email notifications via Resend (https://resend.com).
# Set as a Supabase Edge Function secret: supabase secrets set RESEND_API_KEY=re_...
# Leave blank to disable outbound email (notification preferences are still saved).
RESEND_API_KEY=""
